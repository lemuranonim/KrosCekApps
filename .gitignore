.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
**/build/
**/.cxx/
/docs/
# Supabase local runtime is ignored, while the ACT sync implementation is
# versioned explicitly.
/supabase/*
!/supabase/config.toml
!/supabase/functions/
/supabase/functions/*
!/supabase/functions/act-master-fields-sync/
!/supabase/functions/act-master-fields-sync/**
!/supabase/functions/master-fields-map-cache/
!/supabase/functions/master-fields-map-cache/**
!/supabase/migrations/
/supabase/migrations/*
!/supabase/migrations/*.sql
!/supabase/migrations/**/*.sql
/local commit/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Client configuration generated locally by Firebase tooling.
**/google-services*.json
**/GoogleService-Info.plist

# FVM Version Cache
.fvm/
**/.claude/settings.local.json

# Environment
.env
*.env
.env.*
!.env.example
